# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Database (Prisma) ───────────────────────────────────────
# Connection pooling via pgBouncer (for app queries)
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/<dbname>?pgbouncer=true
# Direct connection (for Prisma migrations)
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/<dbname>

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_<your-key>
RESEND_FROM_EMAIL=noreply@optotech.com.br

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_<your-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-key>
STRIPE_CONECTA_MONTHLY_PRICE_ID=price_<monthly-price-id>
STRIPE_CONECTA_ANNUAL_PRICE_ID=price_<annual-price-id>

# ─── Twilio (only needed for Conecta plan) ───────────────────
TWILIO_ACCOUNT_SID=AC<your-sid>
# Prefer a restricted API Key scoped to Messages:Create over the Auth Token.
# The Auth Token is a master credential: it can buy numbers, spend your balance
# and close the account. Set these two and TWILIO_AUTH_TOKEN becomes unnecessary.
TWILIO_API_KEY_SID=SK<your-api-key-sid>
TWILIO_API_KEY_SECRET=<your-api-key-secret>
# Fallback, used only when the API Key pair above is absent.
TWILIO_AUTH_TOKEN=<your-token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+15005550006

# ─── Z-API — Brazilian WhatsApp fallback (optional) ──────────
# If set, Z-API is preferred over Twilio for WhatsApp
ZAPI_INSTANCE_ID=<your-instance-id>
ZAPI_TOKEN=<your-token>

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OptoTech

# ─── Security ────────────────────────────────────────────────
# Secret used to authenticate pg_cron webhook calls
CRON_SECRET=<generate-a-random-secret-min-32-chars>

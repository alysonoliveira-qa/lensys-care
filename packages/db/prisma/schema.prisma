// ─────────────────────────────────────────────────────────────────────────────
// OptoTech — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  OPTOMETRIST
  RECEPTIONIST

  @@map("role")
}

enum AlertStatus {
  PENDING
  SENT
  DISMISSED

  @@map("alert_status")
}

enum AlertChannel {
  EMAIL
  WHATSAPP
  SMS

  @@map("alert_channel")
}

enum Plan {
  ESSENTIAL
  CONECTA
  PROFESSIONAL

  @@map("plan")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invite_status")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELED
  PAST_DUE

  @@map("subscription_status")
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
  REFUNDED

  @@map("payment_status")
}

enum AppointmentStatus {
  SCHEDULED
  ATTENDED
  CANCELED

  @@map("appointment_status")
}

// ─── Clinic (Tenant) ─────────────────────────────────────────────────────────

model Clinic {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  cnpj       String?
  phone      String?
  email      String
  logo_url   String?
  owner_id   String?  @db.Uuid // Profile.id of the clinic owner (set on registration)
  created_at DateTime @default(now()) @db.Timestamptz

  // Relations
  profiles        Profile[]
  patients        Patient[]
  subscription    Subscription?
  stripe_customer StripeCustomer?
  payments        Payment[]
  invites         Invite[]
  appointments    Appointment[]
  referrers       Referrer[]

  @@map("clinics")
}

// ─── Profile (User / Professional) ───────────────────────────────────────────

model Profile {
  id             String   @id @db.Uuid // mirrors auth.users.id from Supabase
  clinic_id      String   @db.Uuid
  full_name      String
  preferred_name String?
  role           Role     @default(OPTOMETRIST)
  crm            String?
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  // Relations
  clinic       Clinic        @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  exams        Exam[]
  appointments Appointment[] // consultas onde este profile é o profissional (reservado p/ futuro)

  @@map("profiles")
}

// ─── Patient ─────────────────────────────────────────────────────────────────

model Patient {
  id         String   @id @default(uuid()) @db.Uuid
  clinic_id  String   @db.Uuid
  full_name  String
  dob        DateTime @db.Date
  phone      String?
  email      String?
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  // Relations
  clinic       Clinic        @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  exams        Exam[]
  alerts       Alert[]
  appointments Appointment[]

  @@map("patients")
}

// ─── Exam (Refractive Record / Prontuário) ────────────────────────────────────

model Exam {
  id           String   @id @default(uuid()) @db.Uuid
  patient_id   String   @db.Uuid
  performed_by String   @db.Uuid
  exam_date    DateTime @db.Date

  // Right eye (Olho Direito)
  od_sph  Decimal? @db.Decimal(4, 2)
  od_cyl  Decimal? @db.Decimal(4, 2)
  od_axis Int?     @db.SmallInt
  od_va   String?

  // Left eye (Olho Esquerdo)
  oe_sph  Decimal? @db.Decimal(4, 2)
  oe_cyl  Decimal? @db.Decimal(4, 2)
  oe_axis Int?     @db.SmallInt
  oe_va   String?

  // Additional data
  addition           Decimal? @db.Decimal(3, 2)
  pd                 Decimal? @db.Decimal(4, 1)
  prescription_notes String?

  created_at DateTime @default(now()) @db.Timestamptz

  // Relations
  patient  Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  examiner Profile @relation(fields: [performed_by], references: [id])
  alerts   Alert[]

  @@map("exams")
}

// ─── Alert ───────────────────────────────────────────────────────────────────

model Alert {
  id         String       @id @default(uuid()) @db.Uuid
  patient_id String       @db.Uuid
  exam_id    String       @db.Uuid
  due_date   DateTime     @db.Date
  status     AlertStatus  @default(PENDING)
  channel    AlertChannel
  sent_at    DateTime?    @db.Timestamptz
  created_at DateTime     @default(now()) @db.Timestamptz

  // Relations
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)

  @@map("alerts")
}

// ─── Subscription ────────────────────────────────────────────────────────────

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  clinic_id              String             @unique @db.Uuid
  plan                   Plan               @default(ESSENTIAL)
  status                 SubscriptionStatus @default(TRIALING)
  trial_ends_at          DateTime?          @db.Timestamptz
  current_period_end     DateTime?          @db.Timestamptz
  payment_provider       String?
  external_id            String? // ID at payment provider (legacy/manual)
  stripe_subscription_id String?            @unique
  stripe_price_id        String?
  cancel_at_period_end   Boolean            @default(false)
  created_at             DateTime           @default(now()) @db.Timestamptz

  // Relations
  clinic Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── StripeCustomer ──────────────────────────────────────────────────────────

model StripeCustomer {
  id                 String   @id @default(uuid()) @db.Uuid
  clinic_id          String   @unique @db.Uuid
  stripe_customer_id String   @unique
  created_at         DateTime @default(now()) @db.Timestamptz

  // Relations
  clinic Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@map("stripe_customers")
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  clinic_id             String        @db.Uuid
  stripe_payment_intent String?
  stripe_invoice_id     String?       @unique
  amount_cents          Int
  currency              String        @default("brl")
  status                PaymentStatus @default(PENDING)
  description           String?
  paid_at               DateTime?     @db.Timestamptz
  created_at            DateTime      @default(now()) @db.Timestamptz

  // Relations
  clinic Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── Invite (Team Member Invitation) ──────────────────────────────────────────

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  clinic_id   String       @db.Uuid
  email       String
  role        Role
  token       String       @unique @default(uuid()) @db.Uuid
  status      InviteStatus @default(PENDING)
  invited_by  String       @db.Uuid // Profile.id of the OWNER who created the invite
  expires_at  DateTime     @db.Timestamptz
  accepted_at DateTime?    @db.Timestamptz
  created_at  DateTime     @default(now()) @db.Timestamptz

  // Relations
  clinic Clinic @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@index([clinic_id, status])
  @@index([email])
  @@index([clinic_id, email])
  // NB: "apenas um convite PENDING por (clinic_id, email)" é garantido por um
  // índice único PARCIAL (WHERE status = 'PENDING') que vive somente no SQL
  // (migration 007) — o Prisma não representa índices parciais.
  @@map("invites")
}

// ─── Appointment (Consulta / Agenda) ──────────────────────────────────────────

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  clinic_id        String            @db.Uuid // tenant (RLS)
  patient_id       String            @db.Uuid
  professional_id  String?           @db.Uuid // reservado p/ futuro (agenda por profissional); não exposto na UI
  referrer_id      String?           @db.Uuid // indicante ("correta"), opcional
  referral_paid_at DateTime?         @db.Timestamptz // quando a indicação foi paga ao indicante (NULL = pendente)
  appointment_date DateTime          @db.Date // dia da consulta (obrigatório)
  scheduled_time   DateTime?         @db.Time // hora local (NULL = fila do dia, por ordem de marcação)
  status           AppointmentStatus @default(SCHEDULED)
  created_by       String            @db.Uuid // Profile.id de quem criou (sem FK, igual a invites.invited_by)
  created_at       DateTime          @default(now()) @db.Timestamptz // desempate da fila (FIFO)
  updated_at       DateTime          @updatedAt @db.Timestamptz

  // Relations
  clinic       Clinic    @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  patient      Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  professional Profile?  @relation(fields: [professional_id], references: [id], onDelete: SetNull)
  referrer     Referrer? @relation(fields: [referrer_id], references: [id], onDelete: SetNull)

  @@index([clinic_id, appointment_date])
  @@index([patient_id])
  @@index([referrer_id])
  @@map("appointments")
}

// ─── Referrer (Indicante / "Correta") ─────────────────────────────────────────

model Referrer {
  id         String   @id @default(uuid()) @db.Uuid
  clinic_id  String   @db.Uuid // tenant (RLS)
  name       String
  pix_key    String? // chave PIX para o pagamento da indicação
  whatsapp   String? // telefone/WhatsApp de contato
  active     Boolean  @default(true) // desativar sem apagar histórico
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  // Relations
  clinic       Clinic        @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinic_id])
  @@map("referrers")
}
